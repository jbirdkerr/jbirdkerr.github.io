---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <div class="terminal-border rounded-lg bg-black/40 p-10 text-center">
    <p class="mb-2 text-yellow-400"><span class="text-red-400">!</span> 404: no such file</p>
    <p class="text-sm text-gray-500">That page doesn't exist. <a href="/" class="text-blue-400 hover:text-blue-300">Back to the index</a>.</p>
  </div>
</BaseLayout>
